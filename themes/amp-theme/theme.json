{
    "slug": "amp-theme",
    "name": "AMP Theme",
    "version": "1.0.0",
    "author": "CMS Studio",
    "description": "Tema cepat ala AMP: tanpa webfont, tanpa JavaScript tambahan, radius tegas 5px, dan layout stabil tanpa pergeseran.",
    "category": "magazine",
    "tags": [
        "amp",
        "cepat",
        "magazine",
        "responsive",
        "aksesibel",
        "seo-ready"
    ],
    "screenshot": "screenshot.svg",
    "supports": {
        "sidebar": "right",
        "hero": true,
        "builder": true,
        "amp": true
    },
    "areas": [
        "announcement",
        "header",
        "menu",
        "top-banner",
        "featured",
        "before-content",
        "main",
        "middle-content",
        "after-content",
        "sidebar",
        "ad-top",
        "ad-bottom",
        "footer-about",
        "footer-links",
        "footer-social",
        "footer-bottom",
        "footer-1",
        "footer-2",
        "footer-3",
        "custom"
    ],
    "settings": [
        {
            "key": "primary_color",
            "label": "Warna utama",
            "type": "color",
            "default": "#2563eb",
            "group": "Warna"
        },
        {
            "key": "primary_dark",
            "label": "Warna utama gelap",
            "type": "color",
            "default": "#1d4ed8",
            "group": "Warna"
        },
        {
            "key": "accent_color",
            "label": "Warna aksen",
            "type": "color",
            "default": "#0891b2",
            "group": "Warna"
        },
        {
            "key": "background_color",
            "label": "Latar halaman",
            "type": "color",
            "default": "#f4f7fb",
            "group": "Warna"
        },
        {
            "key": "surface_color",
            "label": "Latar kartu",
            "type": "color",
            "default": "#ffffff",
            "group": "Warna"
        },
        {
            "key": "text_color",
            "label": "Warna teks",
            "type": "color",
            "default": "#172554",
            "group": "Warna"
        },
        {
            "key": "muted_color",
            "label": "Teks sekunder",
            "type": "color",
            "default": "#64748b",
            "group": "Warna"
        },
        {
            "key": "border_color",
            "label": "Garis tepi",
            "type": "color",
            "default": "#e2e8f0",
            "group": "Warna"
        },
        {
            "key": "font_pair",
            "label": "Pasangan font (URL stylesheet)",
            "type": "text",
            "default": "",
            "description": "Biarkan kosong untuk tetap nol permintaan font (paling cepat, disarankan untuk AMP).",
            "group": "Tipografi"
        },
        {
            "key": "font_family",
            "label": "Font teks",
            "type": "text",
            "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
            "group": "Tipografi"
        },
        {
            "key": "font_heading",
            "label": "Font judul",
            "type": "text",
            "default": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
            "group": "Tipografi"
        },
        {
            "key": "font_size",
            "label": "Ukuran teks (px)",
            "type": "number",
            "default": 17,
            "min": 14,
            "max": 22,
            "group": "Tipografi"
        },
        {
            "key": "radius",
            "label": "Radius sudut (px)",
            "type": "number",
            "default": 5,
            "min": 0,
            "max": 24,
            "group": "Tata letak"
        },
        {
            "key": "content_width",
            "label": "Lebar konten (px)",
            "type": "number",
            "default": 1180,
            "min": 900,
            "max": 1600,
            "group": "Tata letak"
        },
        {
            "key": "spacing",
            "label": "Jarak antar blok (px)",
            "type": "number",
            "default": 26,
            "min": 12,
            "max": 48,
            "group": "Tata letak"
        },
        {
            "key": "sidebar_position",
            "label": "Posisi sidebar",
            "type": "select",
            "default": "right",
            "options": {
                "left": "Kiri",
                "right": "Kanan",
                "none": "Tanpa sidebar"
            },
            "group": "Tata letak"
        },
        {
            "key": "header_style",
            "label": "Gaya header",
            "type": "select",
            "default": "compact",
            "options": {
                "classic": "Klasik",
                "compact": "Ringkas (sticky)",
                "centered": "Tengah",
                "transparent": "Transparan"
            },
            "group": "Tata letak"
        },
        {
            "key": "footer_style",
            "label": "Gaya footer",
            "type": "select",
            "default": "dark",
            "options": {
                "dark": "Gelap",
                "plain": "Terang",
                "tinted": "Biru muda",
                "minimal": "Minimal"
            },
            "group": "Tata letak"
        },
        {
            "key": "card_style",
            "label": "Gaya kartu artikel",
            "type": "select",
            "default": "feature",
            "options": {
                "feature": "Feature (gambar atas)",
                "cover": "Cover (teks di atas gambar)",
                "compact": "Ringkas (gambar samping)",
                "minimal": "Minimal (tanpa bingkai)",
                "list": "Daftar"
            },
            "group": "Tata letak"
        },
        {
            "key": "custom_css",
            "label": "CSS kustom",
            "type": "textarea",
            "default": "",
            "group": "Lanjutan"
        },
        {
            "key": "show_hero",
            "label": "Tampilkan area unggulan",
            "type": "checkbox",
            "default": 1,
            "group": "Lanjutan"
        },
        {
            "key": "show_breadcrumbs",
            "label": "Tampilkan breadcrumb",
            "type": "checkbox",
            "default": 1,
            "group": "Lanjutan"
        },
        {
            "key": "show_reading_time",
            "label": "Tampilkan waktu baca",
            "type": "checkbox",
            "default": 1,
            "group": "Lanjutan"
        }
    ],
    "layouts": {
        "home": "default",
        "post": "default",
        "page": "default"
    }
}
