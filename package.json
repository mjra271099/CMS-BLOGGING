{
  "name": "cms-admin-editor",
  "private": true,
  "version": "1.0.0",
  "description": "Build tooling for the self-hosted Tiptap rich text editor used in the CMS admin.",
  "type": "module",
  "scripts": {
    "build": "esbuild resources/editor/editor.js --bundle --format=iife --global-name=CMSRichEditor --outfile=assets/vendor/tiptap/editor.js --minify --target=es2019 --legal-comments=none"
  },
  "devDependencies": {
    "@tiptap/core": "^3.33.1",
    "@tiptap/extension-character-count": "^3.33.1",
    "@tiptap/extension-code-block-lowlight": "^3.33.1",
    "@tiptap/extension-color": "^3.33.1",
    "@tiptap/extension-highlight": "^3.33.1",
    "@tiptap/extension-image": "^3.33.1",
    "@tiptap/extension-placeholder": "^3.33.1",
    "@tiptap/extension-table": "^3.33.1",
    "@tiptap/extension-text-align": "^3.33.1",
    "@tiptap/extension-text-style": "^3.33.1",
    "@tiptap/pm": "^3.33.1",
    "@tiptap/starter-kit": "^3.33.1",
    "esbuild": "^0.25.0",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0"
  }
}
